CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Display / LVGL clock bring-up
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ESP32-C6 radio companion, JC4880P443C_I_W v1.3 wiring.
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_HOST_FEAT_HEARTBEAT=y
CONFIG_ESP_HOSTED_HOST_FEAT_HEARTBEAT_AUTO_INIT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_TASK_WDT_EN=y

# RE-3 esp-sr spike: stock wn9 "Hi ESP" wake word model, the only model
# selected, so AFE and WakeNet link into the image. Multinet stays at its
# NONE default. Model data deployment (model partition vs embedded) is RE-8.
CONFIG_SR_WN_WN9_HIESP=y

# RE-9 OTA Application Rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y


CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_FREERTOS_USE_TRACE_FACILITY=y

CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# ESP32-P4 v1.3 does not have ECDSA hardware peripheral support
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
CONFIG_ESP_HTTP_CLIENT_SAVE_RESPONSE_HEADERS=y
CONFIG_ROCKSERVER_BASE_URL="https://rockplatform.win"
# Cast relay serving over a weak RF link needs a send buffer that can
# keep ~300 KB/s in flight at 200 ms RTT; the 4xMSS default caps it at
# ~28 KB/s and deadlocks the stream in a zero-window stall.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=57480
CONFIG_LWIP_TCP_WND_DEFAULT=32400

# Place TLS and mDNS buffers in SPIRAM to keep internal SRAM free for DMA/AES
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_ESP_HTTP_CLIENT_MAX_RESPONSE_HEADER_SIZE=256
CONFIG_ESP_HTTP_CLIENT_MAX_SAVED_RESPONSE_HEADERS=20
